{
  "manifest_version": 3,
  "name": "B站直播预言（竞猜）网页版",
  "version": "1.0.1",
  "description": "让 B 站直播间的「预言」竞猜玩法在网页端也能查看和参与（原本仅手机 App 可用）。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
